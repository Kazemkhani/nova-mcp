{
  "name": "nova-mcp",
  "version": "1.0.0",
  "description": "Official Model Context Protocol (MCP) server for NOVA Labs — place AI voice-agent calls, track them, read quality scores, and manage webhooks via the NOVA API.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "nova-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "prepublishOnly": "npm run verify",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "anthropic",
    "claude",
    "voice-ai",
    "voice-agent",
    "sales-agent",
    "nova-labs",
    "outbound-calling",
    "sales-automation",
    "uae",
    "dubai"
  ],
  "author": "NOVA Labs <ceo@novalabs.ae> (https://novalabs.ae)",
  "homepage": "https://github.com/Kazemkhani/nova-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kazemkhani/nova-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Kazemkhani/nova-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.8"
  }
}
